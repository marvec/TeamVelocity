# TeamVelocity — CLI puller secrets.
# Copy this file to `.env` (git-ignored) and fill in a real token.
# This token is used ONLY by the CLI puller (`bun run pull`). It is never
# written into public/data/, never imported by src/, and never logged.

# GitHub Personal Access Token with `repo` + `read:org` scope.
# Classic PAT (ghp_...) or fine-grained PAT both work.
GITHUB_TOKEN=ghp_replace_me
