{
  "name": "teamvelocity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first, backend-free analytics for a software team's GitHub activity.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pull": "bun run cli/pull.ts",
    "generate:sample": "TZ=Europe/Prague bun run cli/generate-sample.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "TZ=Europe/Prague vitest run",
    "test:watch": "TZ=Europe/Prague vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "octokit": "5.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.3.0",
    "zod": "4.5.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
